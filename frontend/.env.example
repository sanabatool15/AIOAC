# Fake values only. Copy to .env.local.
# Backend address (no trailing path: the backend routes are /projects, /payments, ...).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# true = built-in mock data, no backend needed (default). false = use the backend (not wired yet, see specs/frontend-integration.md).
NEXT_PUBLIC_USE_MOCK_API=true
