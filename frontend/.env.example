# Fake values only. Copy to .env.local.
# Backend address (no trailing path: the backend routes are /projects, /payments, ...).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# true = built-in mock data, no backend needed (default). false = use the backend for the demo path (see README).
NEXT_PUBLIC_USE_MOCK_API=true
# true = show a "Try the demo" button on the login screen (real mode only; the server must enable POST /auth/demo).
NEXT_PUBLIC_DEMO_LOGIN=false
