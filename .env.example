# Fake placeholders only. Never commit real values.
DATABASE_URL=sqlite:///./aioac.db
STORAGE_DIR=./storage
PAYMENT_PROVIDER=mock
TRAINING_BACKEND=local
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=set-a-current-openrouter-model-id
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id
# SageMaker backend (only used when TRAINING_BACKEND=sagemaker). Fake placeholders.
SAGEMAKER_REGION=us-east-1
SAGEMAKER_BUCKET=your-aioac-bucket-name
SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/your-training-role
SAGEMAKER_INSTANCE_TYPE=ml.m5.xlarge
SAGEMAKER_SKLEARN_VERSION=1.4-2
# AWS credentials come from the standard AWS chain (named profile or environment), never from this file.
