# Fake placeholders only. Never commit real values.
DATABASE_URL=sqlite:///./aioac.db
STORAGE_DIR=./storage
PAYMENT_PROVIDER=mock
TRAINING_BACKEND=local
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=set-a-current-openrouter-model-id
# Azure AI Foundry instead of OpenRouter: set LLM_PROVIDER=azure
LLM_PROVIDER=openrouter
AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_MODEL=your-deployment-name
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id
PAYPAL_RETURN_URL=http://localhost:3000/pay/return
PAYPAL_CANCEL_URL=http://localhost:3000/pay/cancel

# Database. SQLite by default. For Supabase see README ("Use Supabase Postgres"); needs pip install -e '.[postgres]'.
# DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres
# DATABASE_POOLED=            # leave empty: auto-detected from port 6543

# Background training. inline = a thread in the API process (default, no network). inngest = Inngest Cloud.
JOB_RUNNER=inline
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key
INNGEST_DEV=false             # true only with the local Inngest dev server, never with Inngest Cloud
# SageMaker backend (only used when TRAINING_BACKEND=sagemaker). Fake placeholders.
SAGEMAKER_REGION=us-east-1
SAGEMAKER_BUCKET=your-aioac-bucket-name
SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/your-training-role
SAGEMAKER_INSTANCE_TYPE=ml.m5.xlarge
SAGEMAKER_SKLEARN_VERSION=1.4-2
# AWS credentials come from the standard AWS chain (named profile or environment), never from this file.
